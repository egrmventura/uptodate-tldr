# Copy this file to .env and fill in the values you need.
# Only the env vars relevant to your enabled sources/delivery channels
# are required.

# --- Core ---
# Anthropic API key, required for summarization.
ANTHROPIC_API_KEY=

# Override config.yaml `topic` without editing the file.
TOPIC=

# Override config.yaml `persona.prompt` without editing the file.
PERSONA_PROMPT=

# --- Reddit (sources/reddit.py) ---
# Create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=uptodate-tldr/0.1 by your-username

# --- LinkedIn (sources/linkedin.py) ---
# RapidAPI key for a LinkedIn search/scraper endpoint (e.g. linkedin-data-api).
# See sources/linkedin.py for fragility notes and how to swap providers.
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# --- Email delivery (delivery/email.py) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Alternative to SMTP: SendGrid API key
SENDGRID_API_KEY=

# --- Substack delivery (delivery/substack.py) ---
# Unofficial API: requires the `substack.sid` session cookie from a logged-in
# browser session. See delivery/substack.py for the fragility writeup.
SUBSTACK_COOKIE=
SUBSTACK_PUBLICATION_URL=
